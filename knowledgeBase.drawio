        <UserObject label="实际上研究的内容是：任务类型怎么组合，简单样本和困难样本怎么配比，长回答和短回答如何混合，推理过程应该展示到什么程度，以及不同领域是否需要单独设计训练数据" mermaidId="n:D03_T01_B02" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="实际上研究的内容是：任务类型怎么组合，简单样本和困难样本怎么配比，长回答和短回答如何混合，推理过程应该展示到什么程度，以及不同领域是否需要单独设计训练数据" id="bMRl6HfLIzmu5vWU7Gti-31">
          <mxCell parent="bMRl6HfLIzmu5vWU7Gti-1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="54" width="1292" x="1301" y="1694" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="有些Reasoning Model还会在强化学习之前加入Cold Start，用高质量的数学、代码、长推理和工具调用数据，先让模型学会基本的解题和执行方式" mermaidId="n:D03_T01_B03" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="有些Reasoning Model还会在强化学习之前加入Cold Start，用高质量的数学、代码、长推理和工具调用数据，先让模型学会基本的解题和执行方式" id="bMRl6HfLIzmu5vWU7Gti-32">
          <mxCell parent="bMRl6HfLIzmu5vWU7Gti-1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="54" width="1082" x="1406" y="1798" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="SFT data curation也是一个方向，有一些面对模型自动生成数据的研究" mermaidId="n:D03_T01_B03_S01" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1.2;fillColor=#FFF7ED;strokeColor=#FB923C;fontColor=#9A3412;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;dashed=1;dashPattern=4 3;fixDash=1;" mermaidBaseValue="SFT data curation也是一个方向，有一些面对模型自动生成数据的研究" id="bMRl6HfLIzmu5vWU7Gti-33">
