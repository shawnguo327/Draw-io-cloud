        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n%% L0 深色胶囊：总主题；L1 深色圆角：研究板块\n%% L2 同色浅底：研究方向；L3 白底：方法/对象，浅橙虚线：关键问题\n%% 箭头表示知识分类，不表示训练流水线、时间先后或因果。\n%% 保留独立 ID，后续可在方法节点下添加论文、实验和个人笔记。\n\n    ROOT([\&quot;LLM 研究知识体系\&quot;]):::root\n\n    %% D01 · Training Data and Scaling\n    D01(\&quot;01 · 训练数据与规模化\&quot;):::domain01\n    ROOT --&gt; D01\n    D01 --&gt; D01_1(\&quot;数据清洗与配比\&quot;):::topic01\n    D01_1 --&gt; D01_1_M[\&quot;去重 · 质量分类 · 语言识别 · 隐私与版权筛查\&quot;]:::method\n    D01_1 --&gt; D01_1_Q[\&quot;关注：代码 / 数学 / 书籍 / 论文 / 论坛 / 多语种配比\&quot;]:::question\n    D01 --&gt; D01_2(\&quot;数据选择与课程学习\&quot;):::topic01\n    D01_2 --&gt; D01_2_M[\&quot;质量评分 · 难度排序 · 动态采样 · 数据影响分析\&quot;]:::method\n    D01_2 --&gt; D01_2_Q[\&quot;关注：样本价值 · 主动选择 · 阶段顺序与难度安排\&quot;]:::question\n    D01 --&gt; D01_3(\&quot;合成数据\&quot;):::topic01\n    D01_3 --&gt; D01_3_M[\&quot;指令与答案生成 · 推理轨迹 · 工具交互轨迹\&quot;]:::method\n    D01_3 --&gt; D01_3_Q[\&quot;关注：高质量数据供给 · 筛选与多样性 · Model collapse 风险\&quot;]:::question\n    D01 --&gt; D01_4(\&quot;持续预训练 CPT\&quot;):::topic01\n    D01_4 --&gt; D01_4_M[\&quot;领域语料 · 新知识补充 · 新旧数据混合\&quot;]:::method\n    D01_4 --&gt; D01_4_Q[\&quot;关注：灾难性遗忘 · 知识冲突 · 成本 · 版权与隐私\&quot;]:::question\n\n    %% D02 · Model Architecture\n    D02(\&quot;02 · 模型架构\&quot;):::domain02\n    ROOT --&gt; D02\n    D02 --&gt; D02_1(\&quot;Transformer 组件与高效注意力\&quot;):::topic02\n    D02_1 --&gt; D02_1_M[\&quot;FlashAttention · 滑窗 / 稀疏 / 分块 · GQA / MQA\&quot;]:::method\n    D02_1 --&gt; D02_1_Q[\&quot;关注：RoPE · Norm · 激活函数 · 层配置 · KV 缓存开销\&quot;]:::question\n    D02 --&gt; D02_2(\&quot;混合专家 MoE\&quot;):::topic02\n    D02_2 --&gt; D02_2_M[\&quot;稀疏路由 · 每个 Token 激活少量专家\&quot;]:::method\n    D02_2 --&gt; D02_2_Q[\&quot;关注：专家负载均衡 · 专家利用率 · 跨卡通信\&quot;]:::question\n    D02 --&gt; D02_3(\&quot;长序列架构\&quot;):::topic02\n    D02_3 --&gt; D02_3_M[\&quot;位置外推 · 递归记忆 · 压缩 · 分层 / 局部—全局注意力\&quot;]:::method\n    D02_3 --&gt; D02_3_Q[\&quot;关注：书籍 / 代码仓库 / 长视频 / 长期记录 · 流式处理\&quot;]:::question\n    D02 --&gt; D02_4(\&quot;状态空间与混合架构\&quot;):::topic02\n    D02_4 --&gt; D02_4_M[\&quot;Mamba · SSM · Attention–SSM 混合\&quot;]:::method\n    D02_4 --&gt; D02_4_Q[\&quot;关注：长序列效率 · 精确读取 · 信息回溯 · 训练稳定性\&quot;]:::question\n\n    %% D03 · Post-training and Alignment\n    D03(\&quot;03 · 后训练与对齐\&quot;):::domain03\n    ROOT --&gt; D03\n    D03 --&gt; D03_1(\&quot;监督微调 SFT\&quot;):::topic03\n    D03_1 --&gt; D03_1_M[\&quot;指令—回答 · 多轮对话 · 推理 / 工具轨迹 · Cold Start\&quot;]:::method\n    D03_1 --&gt; D03_1_Q[\&quot;关注：指令遵循 · 任务与难度配比 · 长度 · 推理展示 · 数据筛选\&quot;]:::question\n    D03 --&gt; D03_2(\&quot;偏好对齐与 AI 反馈\&quot;):::topic03\n    D03_2 --&gt; D03_2_M[\&quot;RLHF / PPO · DPO / IPO / KTO / SimPO · 在线偏好优化\&quot;]:::method\n    D03_2 --&gt; D03_2_Q[\&quot;关注：人类与 AI 偏好 · RLAIF · Constitutional AI\&quot;]:::question\n    D03 --&gt; D03_3(\&quot;面向推理的强化学习\&quot;):::topic03\n    D03_3 --&gt; D03_3_M[\&quot;RLVR · GRPO · DAPO · 程序 / 数学 / 测试 / 形式化验证\&quot;]:::method\n    D03_3 --&gt; D03_3_Q[\&quot;关注：奖励质量 · 探索与采样 · 长度控制 · 拒绝采样 / 迭代 SFT\&quot;]:::question\n    D03 --&gt; D03_4(\&quot;知识蒸馏与 OPD\&quot;):::topic03\n    D03_4 --&gt; D03_4_M[\&quot;教师到学生迁移 · 学生轨迹上的教师 Token 分布 · MiniLLM / GKD\&quot;]:::method\n    D03_4 --&gt; D03_4_Q[\&quot;关注：分布匹配与 KL 选择 · 暴露偏差 · 能力迁移与泛化\&quot;]:::question\n    D03 --&gt; D03_5(\&quot;参数高效微调 PEFT\&quot;):::topic03\n    D03_5 --&gt; D03_5_M[\&quot;LoRA · Adapter · Prompt Tuning · Adapter 组合\&quot;]:::method\n    D03_5 --&gt; D03_5_Q[\&quot;关注：个性化 · 用户偏好 · 持续对齐 · 隐私\&quot;]:::question\n\n    %% D04 · Reasoning, Verification and Planning\n    D04(\&quot;04 · 推理、验证与规划\&quot;):::domain04\n    ROOT --&gt; D04\n    D04 --&gt; D04_1(\&quot;推理链与搜索\&quot;):::topic04\n    D04_1 --&gt; D04_1_M[\&quot;CoT · ToT · GoT · Self-Consistency · 剪枝\&quot;]:::method\n    D04_1 --&gt; D04_1_Q[\&quot;关注：推理表示 · 分支搜索 · 候选聚合与选择\&quot;]:::question\n    D04 --&gt; D04_2(\&quot;过程监督与验证器\&quot;):::topic04\n    D04_2 --&gt; D04_2_M[\&quot;中间步骤监督 · Process Reward Model · Verifier\&quot;]:::method\n    D04_2 --&gt; D04_2_Q[\&quot;关注：步骤正确性 · 错误定位 · 过程与最终结果一致性\&quot;]:::question\n    D04 --&gt; D04_3(\&quot;推理时扩展 Test-time Scaling\&quot;):::topic04\n    D04_3 --&gt; D04_3_M[\&quot;增加推理预算 · Best-of-N · 多次采样 · 搜索与验证\&quot;]:::method\n    D04_3 --&gt; D04_3_Q[\&quot;关注：算力分配 · 成本—效果关系 · 验证器可靠性\&quot;]:::question\n\n    %% D05 · Knowledge, Retrieval, Long Context and Memory\n    D05(\&quot;05 · 知识、检索与记忆\&quot;):::domain05\n    ROOT --&gt; D05\n    D05 --&gt; D05_1(\&quot;检索增强生成 RAG\&quot;):::topic05\n    D05_1 --&gt; D05_1_M[\&quot;外部资料 · 检索 · 上下文补充 · 回答生成\&quot;]:::method\n    D05_1 --&gt; D05_1_Q[\&quot;关注：检索相关性 · 证据覆盖 · 引用与知识更新\&quot;]:::question\n    D05 --&gt; D05_2(\&quot;长上下文利用\&quot;):::topic05\n    D05_2 --&gt; D05_2_M[\&quot;位置外推 · 上下文压缩 · 分层 / 局部—全局注意力\&quot;]:::method\n    D05_2 --&gt; D05_2_Q[\&quot;关注：标称与有效长度 · Lost in the Middle · 信息利用\&quot;]:::question\n    D05 --&gt; D05_3(\&quot;长期记忆\&quot;):::topic05\n    D05_3 --&gt; D05_3_M[\&quot;记忆选择 · 存储 · 检索 · 更新 · 删除\&quot;]:::method\n    D05_3 --&gt; D05_3_Q[\&quot;关注：什么值得记 · 冲突与过时信息 · 修改的局部影响\&quot;]:::question\n    D05 --&gt; D05_4(\&quot;知识编辑与幻觉缓解\&quot;):::topic05\n    D05_4 --&gt; D05_4_M[\&quot;事实编辑 · 置信度检查 · 检索与验证器\&quot;]:::method\n    D05_4 --&gt; D05_4_Q[\&quot;关注：修改准确性 · 其他知识不受损 · 错误识别与缓解\&quot;]:::question\n\n    %% D06 · LLM Agents and Tool Use\n    D06(\&quot;06 · 智能体与工具使用\&quot;):::domain06\n    ROOT --&gt; D06\n    D06 --&gt; D06_1(\&quot;工具学习与函数调用\&quot;):::topic06\n    D06_1 --&gt; D06_1_M[\&quot;Toolformer · Function Calling · 人工 / 合成轨迹 · IL / RL\&quot;]:::method\n    D06_1 --&gt; D06_1_Q[\&quot;关注：工具理解与选择 · 参数填写 · 调用结果处理\&quot;]:::question\n    D06 --&gt; D06_2(\&quot;规划、反思与执行\&quot;):::topic06\n    D06_2 --&gt; D06_2_M[\&quot;ReAct · 推理与行动交替 · 反馈与计划更新\&quot;]:::method\n    D06_2 --&gt; D06_2_Q[\&quot;关注：发现偏离 · 判断计划错误 · 失败恢复\&quot;]:::question\n    D06 --&gt; D06_3(\&quot;计算机使用与具身智能体\&quot;):::topic06\n    D06_3 --&gt; D06_3_M[\&quot;GUI 操作 · 环境感知 · 动作执行 · 