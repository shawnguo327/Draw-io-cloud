        <UserObject label="Preference alignment and AI feedback" mermaidId="n:D03_T02" mermaidBaseStyle="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#6D28D9;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;fontStyle=1;" mermaidBaseValue="Preference alignment and AI feedback" id="bMRl6HfLIzmu5vWU7Gti-34">
          <mxCell parent="bMRl6HfLIzmu5vWU7Gti-1" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#6D28D9;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;fontStyle=1;" vertex="1">
            <mxGeometry height="54" width="304" x="681" y="2006" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="让模型更倾向于生成评价者认为更好的回答" mermaidId="n:D03_T02_B01" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="让模型更倾向于生成评价者认为更好的回答" id="bMRl6HfLIzmu5vWU7Gti-35">
          <mxCell parent="bMRl6HfLIzmu5vWU7Gti-1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="54" width="364" x="1765" y="1902" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="路线有RLHF训练Reward model（PPO），DPO直接训练；除此之外，还有IPO、KTO、SimPO和Online Preference Optimization等方法，分别从目标函数、偏好数据形式和在线采样等方面进行改进。" mermaidId="n:D03_T02_B02" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="路线有RLHF训练Reward model（PPO），DPO直接训练；除此之外，还有IPO、KTO、SimPO和Online Preference Optimization等方法，分别从目标函数、偏好数据形式和在线采样等方面进行改进。" id="bMRl6HfLIzmu5vWU7Gti-36">
          <mxCell parent="bMRl6HfLIzmu5vWU7Gti-1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="54" width="1437" x="1228" y="2006" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="RLAIF，Constitutional AI，不同方法节省人类反馈需要" mermaidId="n:D03_T02_B03" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="RLAIF，Constitutional AI，不同方法节省人类反馈需要" id="bMRl6HfLIzmu5vWU7Gti-37">
          <mxCell parent="bMRl6HfLIzmu5vWU7Gti-1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="54" width="442" x="1726" y="2110" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Reasoning-oriented RL" mermaidId="n:D03_T03" mermaidBaseStyle="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#6D28D9;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;fontStyle=1;" mermaidBaseValue="Reasoning-oriented RL" id="bMRl6HfLIzmu5vWU7Gti-38">
          <mxCell parent="bMRl6HfLIzmu5vWU7Gti-1" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#6D28D9;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;fontStyle=1;" vertex="1">
            <mxGeometry height="54" width="190" x="738" y="2318" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="RLVR，verifiable rewards。通常会让模型针对同一个问题生成多条解答，再通过程序、测试用例、数学答案或形式化验证器判断结果是否正确，最后用这些奖励更新模型。" mermaidId="n:D03_T03_B01" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="RLVR，verifiable rewards。通常会让模型针对同一个问题生成多条解答，再通过程序、测试用例、数学答案或形式化验证器判断结果是否正确，最后用这些奖励更新模型。" id="bMRl6HfLIzmu5vWU7Gti-39">
          <mxCell parent="bMRl6HfLIzmu5vWU7Gti-1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="54" width="1264" x="1315" y="2214" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="GRPO，比较同一个问题下多条回答的相对奖励，减少对value model的需要。DAPO则针对长链推理中的采样效率、策略更新和长度控制等问题继续做改进" mermaidId="n:D03_T03_B02" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="GRPO，比较同一个问题下多条回答的相对奖励，减少对value model的需要。DAPO则针对长链推理中的采样效率、策略更新和长度控制等问题继续做改进" id="bMRl6HfLIzmu5vWU7Gti-40">
          <mxCell parent="bMRl6HfLIzmu5vWU7Gti-1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="54" width="1138" x="1378" y="2318" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="模型通过反复尝试找到更有效的推理策略。模型可以在多次采样和奖励反馈中逐渐发现新的解题路径，Rejection Sampling、Best-of-N和Iterative SFT也经常和这类训练流程结合使用。" mermaidId="n:D03_T03_B03" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="模型通过反复尝试找到更有效的推理策略。模型可以在多次采样和奖励反馈中逐渐发现新的解题路径，Rejection Sampling、Best-of-N和Iterative SFT也经常和这类训练流程结合使用。" id="bMRl6HfLIzmu5vWU7Gti-41">
          <mxCell parent="bMRl6HfLIzmu5vWU7Gti-1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="54" width="1348" x="1273" y="2422" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="On policy distilation and Strong to weak transfer（OPD）" mermaidId="n:D03_T04" mermaidBaseStyle="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#6D28D9;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;fontStyle=1;" mermaidBaseValue="On policy distilation and Strong to weak transfer（OPD）" id="bMRl6HfLIzmu5vWU7Gti-42">
          <mxCell parent="bMRl6HfLIzmu5vWU7Gti-1" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#6D28D9;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;fontStyle=1;" vertex="1">
            <mxGeometry height="54" width="440" x="613" y="2630" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="传统distilation是学生拟合教师，现在OPD让教师为学生生成的轨迹上提供soft target，比如token level的probability distribution并通过reversed KL等指标来学习。直观上改善效果，减轻exposure bias，改善长文本生成和calibration" mermaidId="n:D03_T04_B01" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="传统distilation是学生拟合教师，现在OPD让教师为学生生成的轨迹上提供soft target，比如token level的probability distribution并通过reversed KL等指标来学习。直观上改善效果，减轻exposure bias，改善长文本生成和calibration" id="bMRl6HfLIzmu5vWU7Gti-43">
          <mxCell parent="bMRl6HfLIzmu5vWU7Gti-1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=default;strokeColor=#DDD6FE;fontColor=#334155;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="54" width="1687" x="1103" y="2526" as="geometry" />
          </mxCell>
        </UserObject>
